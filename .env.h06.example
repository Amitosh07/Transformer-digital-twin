# Local-only demo defaults. Optional; Compose does not require a .env file.
DEMO_DB_PORT=55433
DEMO_MQTT_PORT=51885
DEMO_HTTP_PORT=8001
DEMO_FRONTEND_PORT=5173
DEMO_MODBUS_PORT=1502
ML_RUNTIME_MODE=DEMO_UNVERIFIED_CONFIG
# STRICT_FITTED requires an authenticated exported release:
# ML_RUNTIME_MODE=STRICT_FITTED
# ML_ARTIFACT_HOST_DIR=./path-to-authenticated-runtime-export
# Never overwrite an existing .env or reset existing volumes.
